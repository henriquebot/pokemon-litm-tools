<div class="pokemon-importer-shell">

  <header class="pokemon-importer-header">

    <nav class="pokemon-importer-tabs">

      <button
        type="button"
        data-tab="people"
        class="{{#if isPeople}}active{{/if}}"
      >
        <i class="fa-solid fa-user-group"></i>
        Pessoas
        <span>{{peopleCount}}</span>
      </button>

      <button
        type="button"
        data-tab="pokemon"
        class="{{#if isPokemon}}active{{/if}}"
      >
        <i class="fa-solid fa-paw"></i>
        Pokémon
        <span>{{pokemonCount}}</span>
      </button>

      <button
        type="button"
        data-tab="props"
        class="{{#if isProps}}active{{/if}}"
      >
        <i class="fa-solid fa-tree"></i>
        Props
        <span>{{propsCount}}</span>
      </button>

    </nav>


    <div class="pokemon-importer-toolbar">

      <input
        type="search"
        data-role="asset-search"
        placeholder="Buscar..."
        autocomplete="off"
      >

      <span>
        <span data-role="visible-count">{{itemCount}}</span>
        /
        {{itemCount}}
      </span>

    </div>


    {{#unless dylanActive}}

      <div class="pokemon-importer-status warning">

        <i class="fa-solid fa-triangle-exclamation"></i>

        Dylan's Animated Tokens não está ativo.

      </div>

    {{/unless}}

  </header>


  {{#if catalogError}}

    <div class="pokemon-importer-error">

      <strong>
        Erro carregando catálogo
      </strong>

      <p>
        {{catalogError}}
      </p>

    </div>

  {{else}}

    <div class="pokemon-importer-list">

      {{#each items}}

        <article
          class="pokemon-asset-card"
          data-asset-card
          data-search="{{search}}"
        >

          <div class="pokemon-asset-preview">

            <img
              src="{{preview}}"
              alt="{{name}}"
              loading="lazy"
            >

          </div>


          <div class="pokemon-asset-info">

            <strong title="{{name}}">
              {{name}}
            </strong>

            {{#if meta}}

              <small>
                {{meta}}
              </small>

            {{/if}}


            {{#if isAnimated}}

              <small class="pokemon-animation-badge ok">

                <i class="fa-solid fa-person-walking"></i>

                Animado

              </small>

            {{else}}

              {{#unless ../isProps}}

                <small class="pokemon-animation-badge">

                  <i class="fa-solid fa-image"></i>

                  Estático

                </small>

              {{/unless}}

            {{/if}}

          </div>


          <button
            type="button"
            data-entry-id="{{id}}"
            data-category="{{category}}"
          >

            <i class="{{buttonIcon}}"></i>

            {{buttonLabel}}

          </button>

        </article>

      {{/each}}

    </div>

  {{/if}}

</div>
