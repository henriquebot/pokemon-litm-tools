<div class="pokemon-importer-shell{{#if previewZoomed}} preview-zoomed{{/if}}">

  <header class="pokemon-importer-header">

    <nav class="pokemon-importer-tabs">

      <button
        type="button"
        data-tab="people"
        class="{{#if isPeople}}active{{/if}}"
      >
        Pessoas
        <span>{{peopleCount}}</span>
      </button>

      <button
        type="button"
        data-tab="pokemon"
        class="{{#if isPokemon}}active{{/if}}"
      >
        Pokémon
        <span>{{pokemonCount}}</span>
      </button>

      <button
        type="button"
        data-tab="props"
        class="{{#if isProps}}active{{/if}}"
      >
        Props
        <span>{{propsCount}}</span>
      </button>

      <button
        type="button"
        data-tab="challenges"
        class="{{#if isChallenges}}active{{/if}}"
      >
        Challenges
        <span>{{challengeCount}}</span>
      </button>

    </nav>


    <div class="pokemon-importer-toolbar">

      <input
        type="search"
        data-role="asset-search"
        placeholder="Buscar..."
        autocomplete="off"
      >

      {{#if isPeople}}

        <select data-role="person-type">

          <option value="all">
            Todos
          </option>

          <option value="trainer-class">
            Trainer Classes
          </option>

          <option value="npc">
            NPCs
          </option>

          <option value="named">
            Personagens
          </option>

          <option value="player">
            Protagonistas
          </option>

          <option value="rival">
            Rivais
          </option>

          <option value="professor">
            Professores
          </option>

          <option value="gym-leader">
            Líderes
          </option>

          <option value="elite-four">
            Elite Four
          </option>

          <option value="villain">
            Vilões
          </option>

        </select>

      {{/if}}

      {{#if isChallenges}}

        <select
          data-role="challenge-folder"
          aria-label="Filtrar por pasta de Challenges"
        >
          <option value="all">
            Todas as subpastas
          </option>

          {{#each challengeFolders}}
            <option value="{{id}}">
              {{path}}
            </option>
          {{/each}}
        </select>

      {{/if}}


      <span class="pokemon-count">

        <span data-role="visible-count">
          {{itemCount}}
        </span>

        /

        {{itemCount}}

      </span>


      {{#unless isChallenges}}

        <button
          type="button"
          data-action="importSelected"
          class="pokemon-import-selected"
        >

          <i class="fa-solid fa-download"></i>

          Importar

          (<span data-role="selected-count">
            {{selectedCount}}
          </span>)

        </button>

      {{/unless}}

    </div>


    <div class="pokemon-selection-tools">

      {{#unless isChallenges}}

        <button
          type="button"
          data-action="selectVisible"
        >
          Selecionar visíveis
        </button>

        <button
          type="button"
          data-action="clearSelection"
        >
          Limpar seleção
        </button>

      {{/unless}}

      <button
        type="button"
        data-action="togglePreviewZoom"
        class="pokemon-preview-zoom{{#if previewZoomed}} active{{/if}}"
        aria-pressed="{{#if previewZoomed}}true{{else}}false{{/if}}"
      >
        <i class="fa-solid {{#if previewZoomed}}fa-magnifying-glass-minus{{else}}fa-magnifying-glass-plus{{/if}}"></i>
        Zoom
      </button>

    </div>

  </header>


  {{#if catalogError}}

    <div class="pokemon-importer-error">
      {{catalogError}}
    </div>

  {{else}}

    <div class="pokemon-importer-list">

      {{#if isChallenges}}

        {{#if challengeRootMissing}}

          <div class="pokemon-challenge-library-empty">
            <i class="fa-solid fa-folder-open"></i>
            <strong>Pasta Challenges não encontrada</strong>
            <span>Crie uma pasta de Actors chamada Challenges. As subpastas serão lidas automaticamente.</span>
          </div>

        {{else}}

          {{#each items}}

            <article
              class="pokemon-asset-card pokemon-challenge-library-card"
              data-challenge-card
              data-challenge-actor-id="{{actorId}}"
              data-challenge-uuid="{{uuid}}"
              data-folder-id="{{folderId}}"
              data-search="{{search}}"
              title="{{folderPath}}"
              draggable="true"
            >

              <div class="pokemon-asset-preview">

                {{#if img}}
                  <img
                    src="{{img}}"
                    alt="{{name}}"
                    loading="lazy"
                  >
                {{else}}
                  <i class="fa-solid fa-triangle-exclamation"></i>
                {{/if}}

              </div>

              <div class="pokemon-asset-info">

                <strong title="{{name}}">
                  {{name}}
                </strong>

                {{#if rolesLabel}}
                  <small class="pokemon-challenge-library-roles">
                    {{rolesLabel}}
                  </small>
                {{/if}}

                {{#if limitsLabel}}
                  <small class="pokemon-challenge-library-limits">
                    {{limitsLabel}}
                  </small>
                {{/if}}

                <button
                  type="button"
                  data-open-challenge="{{actorId}}"
                  title="Abrir ficha do Challenge"
                >
                  <i class="fa-solid fa-up-right-from-square"></i>
                  Abrir ficha
                </button>

              </div>

            </article>

          {{/each}}

        {{/if}}

      {{else}}

      {{#each items}}

        <article
          class="pokemon-asset-card"
          data-asset-card
          data-search="{{search}}"
          data-person-type="{{personType}}"
          data-gender="{{gender}}"
          data-category="{{category}}"
          data-asset-id="{{id}}"
          data-entry-name="{{name}}"
          draggable="true"
        >

          <label class="pokemon-select-box">

            <input
              type="checkbox"
              data-select-entry="{{category}}:{{id}}"
              data-category="{{category}}"
              data-id="{{id}}"
              {{#if checked}}checked{{/if}}
            >

          </label>


          <div class="pokemon-asset-preview">

            {{#if previewCropped}}

              <div class="pokemon-overworld-preview">

                <img
                  src="{{preview}}"
                  alt="{{name}}"
                  loading="lazy"
                  data-overworld-preview
                  data-preview-columns="{{previewColumns}}"
                  data-preview-rows="{{previewRows}}"
                >

              </div>

            {{else}}

              <img
                src="{{preview}}"
                alt="{{name}}"
                loading="lazy"
              >

            {{/if}}

          </div>


          <div class="pokemon-asset-info">

            <strong title="{{name}}">
              {{name}}
            </strong>

            {{#if canChooseTrainerName}}

              <div class="pokemon-trainer-name-row">

                <input
                  type="text"
                  value="{{trainerName}}"
                  data-trainer-name="{{id}}"
                  aria-label="Nome do treinador"
                  autocomplete="off"
                  draggable="false"
                >

                <button
                  type="button"
                  data-next-trainer-name="{{id}}"
                  title="Próximo nome"
                  aria-label="Próximo nome"
                  draggable="false"
                >
                  <i class="fa-solid fa-shuffle"></i>
                </button>

              </div>

            {{/if}}

            {{#if meta}}

              <small>
                {{meta}}
              </small>

            {{/if}}

            {{#if secondaryMeta}}

              <small class="pokemon-provider">
                {{secondaryMeta}}
              </small>

            {{/if}}

            {{#if ../isPokemon}}

              <div class="pokemon-asset-actions">

                <button
                  type="button"
                  class="pokemon-builder-link"
                  data-pokemon-builder="{{id}}"
                  title="Criar Pokémon como Challenge"
                >
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                  Challenge
                </button>

                <button
                  type="button"
                  class="pokemon-theme-builder-link"
                  data-pokemon-theme-builder="{{id}}"
                  title="Criar diretamente como Tema de um treinador-jogador"
                >
                  <i class="fa-solid fa-book-open"></i>
                  Tema
                </button>


                {{#if pokedexUrl}}

                  <button
                    type="button"
                    class="pokemon-pokedex-link"
                    data-pokedex-url="{{pokedexUrl}}"
                    title="Abrir no Pok&eacute;monDB"
                  >
                    <i class="fa-solid fa-mobile-screen-button"></i>
                    Pok&eacute;dex
                  </button>

                {{/if}}

              </div>

            {{/if}}


            {{#if isAnimated}}

              <small class="pokemon-animation-badge ok">

                <i class="fa-solid fa-person-walking"></i>

                Animado

              </small>

            {{else}}

              {{#unless ../isProps}}

                <small class="pokemon-animation-badge">
                  Estático
                </small>

              {{/unless}}

            {{/if}}

          </div>

        </article>

      {{/each}}

      {{/if}}

    </div>

  {{/if}}

</div>
